# Create a file called .env alongside app.py and replace values with YOUR local Oracle details.
# Example DSN for Oracle XE (PDB): localhost:1521/XEPDB1
# Example DSN for Oracle Free: localhost:1521/FREEPDB1
ORACLE_USER=your_oracle_username
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=localhost:1521/FREEPDB1
FLASK_SECRET_KEY=choose_any_random_local_demo_key

# Website: keep 127.0.0.1 for access from this computer only.
APP_HOST=127.0.0.1
PORT=5000

# Use Connect Shared Oracle.cmd to verify and select a friend's project database.
# local starts this PC's container; remote connects without creating/seeding tables.
ORACLE_MODE=local
